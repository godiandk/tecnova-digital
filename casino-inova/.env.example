# Copie pra .env e preencha. O .env não entra no repositório (ver .gitignore).

# --- Obrigatórias: o servidor não sobe sem elas ---

# Onde o Postgres está. Sem valor padrão de propósito, pra nunca subir gravando
# num banco que ninguém escolheu.
DATABASE_URL=postgres://postgres@localhost:5432/casino_inova

# Assina os tokens de sessão. Use algo longo e aleatório em produção — quem tiver
# este valor consegue forjar token de qualquer jogador.
JWT_SECRET=troque-isto-por-algo-longo-e-aleatorio

# --- Opcionais ---

# Login social (Google/Apple/Facebook). O JSON inteiro da chave de serviço do
# Firebase, em uma linha. Sem ela, o login social recusa e o app esconde os
# botões — o login por e-mail e senha continua funcionando.
# Ver docs/como-ligar-o-firebase.md.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Confere a assinatura do webhook de compra. Sem ela, o webhook recusa tudo.
# PURCHASE_WEBHOOK_SECRET=

# SÓ EM DESENVOLVIMENTO. Libera POST /store/comprar, que credita ficha sem
# ninguém ter pago. Em produção, simplesmente não defina.
PERMITIR_COMPRA_DE_TESTE=true

# --- Segurança: ver docs/auditoria-de-seguranca-do-aplicativo.md ---

# DE ONDE O NAVEGADOR PODE FALAR COM A API, separadas por vírgula. Sem esta
# variável valem só localhost e a rede local privada — que é como se testa no
# celular. EM PRODUÇÃO ELA É OBRIGATÓRIA NA PRÁTICA: sem ela, o site publicado
# não consegue chamar a própria API.
#
# Pedido sem cabeçalho Origin (aplicativo nativo, curl, webhook de pagamento)
# passa de qualquer jeito — quem não é navegador não manda esse cabeçalho, e
# usar a ausência dele como tranca não tranca nada. Quem protege essas portas é
# o token e a assinatura HMAC.
# ORIGENS_PERMITIDAS=https://casinoinova.com,https://www.casinoinova.com

# SÓ LIGUE COM UM PROXY DE VERDADE NA FRENTE (nginx, Cloudflare, balanceador).
# Quando ligada, o limite de tentativas lê o IP de `x-forwarded-for` — que é um
# cabeçalho escrito pelo cliente. Sem proxy, qualquer um inventa um IP a cada
# pedido e passa por cima do limite; com proxy, ele é o único jeito de saber
# quem é.
# CONFIAR_NO_PROXY=true

# Liga o HSTS (o navegador passa a recusar HTTP depois da primeira visita).
# Fica de fora em desenvolvimento de propósito: ligado, ele trancaria localhost
# no HTTPS.
# NODE_ENV=production

# Banco separado onde os verificadores rodam. Eles APAGAM as tabelas antes de
# cada cenário — nunca aponte isto pro banco de verdade.
TEST_DATABASE_URL=postgres://postgres@localhost:5432/casino_inova_test
